{
  // ────────────────────────────────────────────────────────────────────────
  //  Configuración de LaTeX Workshop para el repositorio Mathwizards STEM
  // ────────────────────────────────────────────────────────────────────────
  //
  //  Los estilos (.sty) viven en <repo>/styles/, fuera del directorio de cada
  //  documento. LaTeX Workshop ejecuta latexmk con cwd = carpeta del .tex, y
  //  latexmk SOLO lee .latexmkrc del cwd o de $HOME (nunca de carpetas padre),
  //  por lo que el .latexmkrc de la raíz no se usa al compilar documentos en
  //  subdirectorios.
  //
  //  Solución PORTABLE (Linux, macOS y Windows): pasar -r %WORKSPACE_FOLDER%/.latexmkrc
  //  para que latexmk cargue el .latexmkrc de la raíz incluso desde subcarpetas.
  //  Así .latexmkrc usa ensure_path('TEXINPUTS', ...), evitando hardcodear ':'
  //  (que rompe kpathsea en Windows, donde el separador es ';').
  // ────────────────────────────────────────────────────────────────────────
  "latex-workshop.latex.tools": [
    {
      "name": "xelatexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-xelatex",
        "-r",
        "%WORKSPACE_FOLDER%/.latexmkrc",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (xelatex)",
      "tools": [
        "xelatexmk"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk (xelatex)"
}
