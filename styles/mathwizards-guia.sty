% ── Alias de compatibilidad (nombres antiguos) ───────────────
\newenvironment{cuadroazul}{\begin{cuadroteoria}}{\end{cuadroteoria}}
\newenvironment{cuadroverde}{\begin{cuadrosolucion}}{\end{cuadrosolucion}}
\newenvironment{cuadronaranja}{\begin{cuadroadvertencia}}{\end{cuadroadvertencia}}
\newenvironment{cuadromorado}{\begin{cuadroextra}}{\end{cuadroextra}}
\newenvironment{cuadrogris}{\begin{cuadroinfo}}{\end{cuadroinfo}}
