% ============================================================
%  mathwizards-ingles.sty
%  Estilo del curso de inglés — Mathwizards Consultoría Educativa STEM
%
%  Requisitos:
%    * Compilar con XeLaTeX  →  latexmk -xelatex archivo.tex
%    * mathwizards-palette.sty en la ruta TEXINPUTS
%
%  Cajas disponibles (tcolorbox, todas con título opcional):
%    cajachunk, cajagrammar, cajaejemplo, cajamineria, cajanivel,
%    cajatransicion, cajaconsolidacion, cajabueno, cajamalo,
%    cajaprincipio, cajatarjeta, cajafilosofia, cajames, cajanota,
%    cajaherramienta, cajapaso, cajaalerta, cajaexito, cajacodigo,
%    cajasesion, cajasemana, cajaseccion
%
%  Los colores de la versión anterior (mes1, mes2, mes3, chunk,
%  grammar, ejemplo, mineria, transicion, consolidacion, bueno,
%  malo, acento, grissuave, fondo, herramienta, paso, alerta,
%  exito, codefondo) apuntan a la paleta de la marca.
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathwizards-ingles}[2026/08/11 v1.0 Curso de inglés Mathwizards]

% ── Paquetes ─────────────────────────────────────────────────
\RequirePackage{fontspec}
\RequirePackage[spanish,es-nodecimaldot]{babel}
\AtBeginDocument{\shorthandoff{"}}
\RequirePackage{icomma}
\RequirePackage{geometry}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins, breakable}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{hyperref}
\RequirePackage{multicol}
\RequirePackage{amssymb}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{positioning, arrows.meta, calc, babel}
\RequirePackage{mathwizards-palette}

\geometry{margin=2.5cm}

% ── Fuentes (marca) ──────────────────────────────────────────
\setmainfont{Cabin}[
  Extension      = .otf,
  UprightFont    = Cabin-Regular,
  BoldFont       = Cabin-Bold,
  ItalicFont     = Cabin-Italic,
  BoldItalicFont = Cabin-BoldItalic
]
\newfontfamily\nxheav{Nexa Heavy}[NFSSFamily=nexaheavy]
\newfontfamily\nxlight{Nexa Extra Light}[NFSSFamily=nexaextralight]

% ── Búsqueda del logo ────────────────────────────────────────
\graphicspath{
  {assets/img/}{../assets/img/}{../../assets/img/}
  {../../../assets/img/}{../../../../assets/img/}
}

% ── Colores del curso → paleta de la marca ───────────────────
\colorlet{mes1}{mwprimario}      % Mes 1 (antes verde bosque)
\colorlet{mes2}{mwnaranja}       % Mes 2 (antes ámbar)
\colorlet{mes3}{mwvioleta}       % Mes 3 (antes naranja tostado)
\colorlet{acento}{mwprimario}
\colorlet{chunk}{mwprimario}
\colorlet{grammar}{mwvioleta}
\colorlet{ejemplo}{mwgrisoscuro}
\colorlet{mineria}{mwrojonaranja}
\colorlet{transicion}{mwmagenta}
\colorlet{consolidacion}{mwmagenta}
\colorlet{bueno}{mwmagenta}
\colorlet{malo}{mwrojonaranja}
\colorlet{grissuave}{mwgris}
\colorlet{fondo}{mwgrisclaro}
\colorlet{herramienta}{mwprimario}
\colorlet{paso}{mwnaranja}
\colorlet{alerta}{mwrojonaranja}
\colorlet{exito}{mwmagenta}
\colorlet{codefondo}{mwgrisclaro}

% ── Estilo común de cajas grandes ────────────────────────────
% (se usa como base para las cajas con título)
\newtcolorbox{cajagrande}[2][]{%
  enhanced, breakable,
  colback=#2!5, colframe=#2,
  fonttitle=\nxheav\large, title={#1},
  arc=3mm, boxrule=1pt,
  left=6pt, right=6pt, top=6pt, bottom=6pt
}

\newtcolorbox{cajamediana}[2][]{%
  enhanced, breakable,
  colback=#2!5, colframe=#2,
  fonttitle=\nxheav, title={#1},
  arc=2mm, boxrule=0.8pt,
  left=5pt, right=5pt, top=4pt, bottom=4pt
}

