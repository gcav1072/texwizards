% ── Comandos de apoyo ────────────────────────────────────────
\newcommand{\eng}[1]{\textbf{\textcolor{mwprimario}{\textit{#1}}}}
\newcommand{\esp}[1]{{\small\color{mwgris}(#1)}}

\newcommand{\sesion}[3]{%
  $\square$ \textbf{Sesión #1} — \textbf{#2}\\
  {\small #3}
  \medskip
}
