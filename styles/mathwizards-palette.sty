% ============================================================
%  mathwizards-palette.sty
%  Paleta de colores — Mathwizards Consultoría Educativa STEM
%  Requiere: xcolor (se carga automáticamente)
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathwizards-palette}[2026/08/11 v1.0 Paleta Mathwizards]

\RequirePackage{xcolor}

% ─────────────────────────────────────────────────────────────
%  Colores de la marca (HTML, según el logo)
% ─────────────────────────────────────────────────────────────
\definecolor{mwprimario}{HTML}{E2232D}      % Rojo primario  (logo)
\definecolor{mwmagenta}{HTML}{E3229F}       % Magenta
\definecolor{mwrojonaranja}{HTML}{E34122}   % Rojo-anaranjado
\definecolor{mwvioleta}{HTML}{C922E3}       % Violeta
\definecolor{mwnaranja}{HTML}{E36322}       % Naranja

% ─────────────────────────────────────────────────────────────
%  Neutros
% ─────────────────────────────────────────────────────────────
\definecolor{mwgrisclaro}{HTML}{F5F5F8}     % Fondos de notas / info
\definecolor{mwgris}{RGB}{102, 102, 102}    % Textos secundarios
\definecolor{mwgrisoscuro}{RGB}{51, 51, 51}

% ─────────────────────────────────────────────────────────────
%  Alias de compatibilidad (preámbulos antiguos)
%  Los nombres viejos apuntan a los nuevos colores de la marca.
%  Sirven para no romper código que aún use los nombres viejos.
% ─────────────────────────────────────────────────────────────
\colorlet{azulprincipal}{mwprimario}
\colorlet{azulclaro}{mwprimario!12}
\colorlet{verdeprincipal}{mwmagenta}
\colorlet{verdeclaro}{mwmagenta!12}
\colorlet{naranjaprincipal}{mwnaranja}
\colorlet{naranjaclaro}{mwnaranja!12}
\colorlet{grisclaro}{mwgrisclaro}
\colorlet{rojoprincipal}{mwrojonaranja}
\colorlet{moradoprincipal}{mwvioleta}
\colorlet{moradoclaro}{mwvioleta!12}
